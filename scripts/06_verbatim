"""
Module 6
Final Verbatim Transcript Builder

Purpose
-------
Generate the final verbatim transcript of the
identified target speaker.

Input
-----
output/target_speaker/*_target.json

Outputs
-------
output/final_transcripts/*.txt
output/final_transcripts/*.json
output/final_transcripts/*_stats.json
"""

# ==========================================================
# Imports
# ==========================================================

import json
import logging
import re
from pathlib import Path

# ==========================================================
# Project Paths
# ==========================================================

PROJECT_ROOT = Path(__file__).resolve().parent.parent

TARGET_DIR = (
    PROJECT_ROOT /
    "output" /
    "target_speaker"
)

OUTPUT_DIR = (
    PROJECT_ROOT /
    "output" /
    "final_transcripts"
)

LOG_DIR = (
    PROJECT_ROOT /
    "output" /
    "logs"
)

OUTPUT_DIR.mkdir(
    parents=True,
    exist_ok=True
)

LOG_DIR.mkdir(
    parents=True,
    exist_ok=True
)

# ==========================================================
# Logging
# ==========================================================

logging.basicConfig(
    filename=LOG_DIR/"final_transcript.log",
    level=logging.INFO,
    format="%(asctime)s | %(levelname)s | %(message)s"
)

logger = logging.getLogger(__name__)

# ==========================================================
# Configuration
# ==========================================================

CONFIG={

    "MERGE_GAP":0.7,

    "MAX_PARAGRAPH_DURATION":60,

    "KEEP_FILLERS":True,

    "KEEP_REPETITIONS":True,

    "KEEP_UNINTELLIGIBLE":True

}

# ==========================================================
# Load Target Speaker File
# ==========================================================

def load_target_file(json_file):

    with open(
        json_file,
        "r",
        encoding="utf8"
    ) as f:

        data=json.load(f)

    segments=data["segments"]

    segments.sort(
        key=lambda x:x["start"]
    )

    return data,segments
# ==========================================================
# Timestamp
# ==========================================================

def format_timestamp(seconds):

    h=int(seconds//3600)

    m=int((seconds%3600)//60)

    s=int(seconds%60)

    if h>0:

        return f"{h:02}:{m:02}:{s:02}"

    return f"{m:02}:{s:02}"
# ==========================================================
# Cleanup Text
# ==========================================================

def clean_text(text):

    text=text.strip()

    text=re.sub(
        r"\s+",
        " ",
        text
    )

    return text

# ==========================================================
# Merge Consecutive Segments
# ==========================================================

def merge_segments(segments):

    if len(segments)==0:

        return []

    merged=[]

    current=segments[0].copy()

    current["text"]=clean_text(
        current["text"]
    )

    for nxt in segments[1:]:

        nxt["text"]=clean_text(
            nxt["text"]
        )

        gap=round(

            nxt["start"]-

            current["end"],

            3

        )

        current_duration=round(

            current["end"]-

            current["start"],

            3

        )

        merge=False

        if gap<=CONFIG["MERGE_GAP"]:

            if current_duration<CONFIG["MAX_PARAGRAPH_DURATION"]:

                if not current["text"].endswith(

                    (
                        ".",
                        "?",
                        "!"
                    )

                ):

                    merge=True

        if merge:

            current["text"]=(

                current["text"]

                +" "

                +nxt["text"]

            ).strip()

            current["end"]=nxt["end"]

            current["duration"]=round(

                current["end"]-

                current["start"],

                3

            )

        else:

            merged.append(current)

            current=nxt.copy()

    merged.append(current)

    for i,seg in enumerate(

        merged,

        start=1

    ):

        seg["segment_id"]=i

    return merged

# ==========================================================
# Transcript Statistics
# ==========================================================

def compute_statistics(segments):

    words=0

    duration=0

    longest=0

    for seg in segments:

        words+=len(

            seg["text"].split()

        )

        duration+=seg["duration"]

        longest=max(

            longest,

            seg["duration"]

        )

    average=0

    if len(segments)>0:

        average=duration/len(segments)

    wpm=0

    if duration>0:

        wpm=(

            words

            /(duration/60)

        )

    return{

        "segments":len(segments),

        "total_words":words,

        "duration":round(duration,2),

        "average_segment":round(

            average,

            2

        ),

        "longest_segment":round(

            longest,

            2

        ),

        "estimated_wpm":round(

            wpm,

            2

        )

    }

# ==========================================================
# Preview
# ==========================================================

def preview(segments,n=5):

    print("\n")

    print("="*60)

    print("Preview")

    print("="*60)

    for seg in segments[:n]:

        print(

            f"[{format_timestamp(seg['start'])}]"

        )

        print(seg["text"])

        print()

# ==========================================================
# Save TXT Transcript
# ==========================================================

def save_txt(audio_name, segments):

    txt_file = OUTPUT_DIR / f"{Path(audio_name).stem}.txt"

    with open(
        txt_file,
        "w",
        encoding="utf8"
    ) as f:

        f.write("=" * 70 + "\n")
        f.write("FINAL VERBATIM TRANSCRIPT\n")
        f.write("=" * 70 + "\n\n")

        for seg in segments:

            timestamp = format_timestamp(seg["start"])

            f.write(f"[{timestamp}]\n")

            f.write(seg["text"])

            f.write("\n\n")

    print(f"Saved TXT : {txt_file.name}")
# ==========================================================
# Save JSON Transcript
# ==========================================================

def save_json(audio_name, segments):

    json_file = OUTPUT_DIR / f"{Path(audio_name).stem}.json"

    output = {

        "audio_file": audio_name,

        "segments": segments

    }

    with open(
        json_file,
        "w",
        encoding="utf8"
    ) as f:

        json.dump(
            output,
            f,
            indent=4,
            ensure_ascii=False
        )

    print(f"Saved JSON : {json_file.name}")

# ==========================================================
# Save Statistics
# ==========================================================

def save_statistics(audio_name, stats):

    stats_file = (
        OUTPUT_DIR /
        f"{Path(audio_name).stem}_stats.json"
    )

    with open(
        stats_file,
        "w",
        encoding="utf8"
    ) as f:

        json.dump(
            stats,
            f,
            indent=4
        )

    print(
        f"Saved Stats : {stats_file.name}"
    )

# ==========================================================
# Process One Conversation
# ==========================================================

def process_file(json_file):

    print("\n")

    print("=" * 60)

    print(f"Processing {json_file.name}")

    print("=" * 60)

    data, segments = load_target_file(json_file)

    print(
        f"Original Segments : {len(segments)}"
    )

    merged = merge_segments(segments)

    print(
        f"Merged Segments   : {len(merged)}"
    )

    stats = compute_statistics(merged)

    preview(merged)

    save_txt(
        json_file.name,
        merged
    )

    save_json(
        json_file.name,
        merged
    )

    save_statistics(
        json_file.name,
        stats
    )

    logger.info(
        f"{json_file.name} "
        f"{len(segments)} -> "
        f"{len(merged)}"
    )

# ==========================================================
# Main
# ==========================================================

def main():

    print("=" * 60)

    print("Module 6")

    print("Final Verbatim Transcript Builder")

    print("=" * 60)

    files = sorted(

        TARGET_DIR.glob("*_target.json")

    )

    success = 0

    failed = 0

    for file in files:

        try:

            process_file(file)

            success += 1

        except Exception as e:

            logger.exception(e)

            print(e)

            failed += 1

    print("\n")

    print("=" * 60)

    print("Module 6 Completed")

    print("=" * 60)

    print(f"Successful : {success}")

    print(f"Failed     : {failed}")

if __name__ == "__main__":

    main()